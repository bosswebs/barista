# Neon direct Postgres connection (server-side only - used by /api/* functions and scripts/, never exposed to the client bundle)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk auth (replaces Supabase Auth)
# Note: this is a Vite app, not Next.js - client-side env vars must use the VITE_ prefix, not NEXT_PUBLIC_
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
